<Window x:Class="GeminiUsageMonitor.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GeminiLimitOverlay"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        IsHitTestVisible="False"
        Focusable="False">
    <Grid IsHitTestVisible="False">
        <!-- М'яке підсвічування по контуру вікна Gemini (реагує ВИКЛЮЧНО на Поточне використання ⚡) -->
        <Border x:Name="FrameGlowBorder"
                Margin="3"
                CornerRadius="8"
                BorderThickness="2.5"
                BorderBrush="Transparent"
                Opacity="0"
                IsHitTestVisible="False">
            <Border.Effect>
                <DropShadowEffect x:Name="FrameGlowShadow"
                                  Color="#FF9F1C"
                                  BlurRadius="16"
                                  ShadowDepth="0"
                                  Opacity="0.9"/>
            </Border.Effect>
        </Border>

        <!-- Верхня права зона: Постійна напівпрозора капсула + спливаюче разове сповіщення під нею -->
        <StackPanel x:Name="TopRightContainer"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,8,204,0"
                    IsHitTestVisible="False">

            <!-- Постійна капсула лімітів: ⚡ Поточне | 📅 Тижневий -->
            <Border x:Name="UsagePill"
                    HorizontalAlignment="Right"
                    Background="#CC1A1C1E"
                    BorderBrush="#3DFFFFFF"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="10,4">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Індикатор активного очікування оновлення після Enter -->
                    <Ellipse x:Name="PendingDot"
                             Width="6"
                             Height="6"
                             Fill="#60A5FA"
                             Margin="0,0,6,0"
                             Visibility="Collapsed"
                             VerticalAlignment="Center"/>

                    <TextBlock x:Name="CurrentUsageText"
                               Text="⚡ --%"
                               Foreground="#E8EAED"
                               FontFamily="Segoe UI Variable Text, Segoe UI"
                               FontSize="12"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>

                    <Border Width="1"
                            Height="12"
                            Background="#38FFFFFF"
                            Margin="8,0"
                            VerticalAlignment="Center"/>

                    <TextBlock x:Name="WeeklyUsageText"
                               Text="📅 --%"
                               Foreground="#BDC1C6"
                               FontFamily="Segoe UI Variable Text, Segoe UI"
                               FontSize="12"
                               FontWeight="Normal"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Дублюючий вбудований банер разового сповіщення (на випадок режиму "Не турбувати" у Windows) -->
            <Border x:Name="InlineAlertBanner"
                    Visibility="Collapsed"
                    HorizontalAlignment="Right"
                    Margin="0,6,0,0"
                    MaxWidth="320"
                    Background="#EB202124"
                    BorderBrush="#FF9F1C"
                    BorderThickness="1.5"
                    CornerRadius="10"
                    Padding="12,8">
                <StackPanel>
                    <TextBlock x:Name="InlineAlertTitle"
                               Foreground="#FFB020"
                               FontFamily="Segoe UI Variable Text, Segoe UI"
                               FontSize="12"
                               FontWeight="Bold"/>
                    <TextBlock x:Name="InlineAlertBody"
                               Foreground="#F1F3F4"
                               FontFamily="Segoe UI Variable Text, Segoe UI"
                               FontSize="11.5"
                               TextWrapping="Wrap"
                               Margin="0,2,0,0"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</Window>
